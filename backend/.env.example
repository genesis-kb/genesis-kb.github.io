# ===========================================
# Bitcoin Transcripts Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (AWS RDS PostgreSQL)
DATABASE_URL=postgresql://user:password@your-rds-endpoint.region.rds.amazonaws.com:5432/postgres

# AI Provider Configuration
# AI_PROVIDER selects who serves /ai/chat, /ai/tts and /ai/entities:
#   bedrock — Amazon Bedrock (text) + Amazon Polly (speech)
#   gemini  — Google Gemini
#   none    — AI endpoints off
# Left unset, a usable GEMINI_API_KEY selects gemini; otherwise AI is off.
# When the selected provider is missing its settings, the AI endpoints
# answer 503 AI_NOT_CONFIGURED and the rest of the API runs normally.
AI_PROVIDER=bedrock

# AWS
# Set both keys to use them explicitly; leave them unset to fall back to
# AWS_PROFILE or an attached IAM role. The identity needs
# bedrock:InvokeModel on the model and polly:SynthesizeSpeech.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=            # only for temporary credentials
AWS_REGION=ap-south-1

# Amazon Bedrock + Polly
# Bedrock model availability varies by region; BEDROCK_REGION lets Bedrock
# run somewhere other than AWS_REGION. Both fall back to AWS_REGION.
BEDROCK_REGION=us-east-1
# POLLY_REGION=
# Any Bedrock model or inference profile ID that supports the Converse API
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BEDROCK_MAX_TOKENS=4096
# POLLY_VOICE_ID=Joanna
# POLLY_ENGINE=neural

# TTS audio storage
# Generated speech is stored once in this private S3 bucket and streamed to
# signed-in users through the backend (no public or presigned URLs). The
# identity above needs s3:GetObject and s3:PutObject on tts-audio/* in it.
# Unset, the /ai/tts endpoints answer 503 TTS_STORAGE_NOT_CONFIGURED.
# TTS_AUDIO_BUCKET=
# S3_REGION=                    # defaults to AWS_REGION

# Google Gemini (only used with AI_PROVIDER=gemini)
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Configuration
# Comma-separated list of allowed origins (no spaces)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Authentication (JWT)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
